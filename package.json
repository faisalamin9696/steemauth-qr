{
  "name": "@steempro/steemauth-qr",
  "version": "3.0.0",
  "description": "Generate SteemAuthenticator QR sessions and request Steem actions (broadcast/vote/transfer/...) from the browser, SteemKeychain-style. Mobile approval + on-device signing via the SteemAuthenticator app.",
  "keywords": [
    "steem",
    "steemauth",
    "steempro",
    "keychain",
    "qr",
    "authenticator",
    "steemauthenticator",
    "blockchain",
    "signing",
    "websocket",
    "relay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisalamin9696/steemauth-qr.git"
  },
  "homepage": "https://github.com/faisalamin9696/steemauth-qr#readme",
  "bugs": {
    "url": "https://github.com/faisalamin9696/steemauth-qr/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-protocol.ts && tsx scripts/verify-operations.ts && tsx scripts/verify-e2e.ts && tsx scripts/verify-relay-plane.ts && tsx scripts/verify-handoff.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "crypto-es": "^3.1.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
